# Copie para .env e preencha. O .env não vai para o git.

# Mercado Livre
ML_APP_ID=0
ML_SECRET_KEY=
ML_SELLER_ID=0
ML_CONTA=

# MySQL
DB_HOST=192.168.15.11
DB_PORT=52002
DB_USER=
DB_PASSWORD=
